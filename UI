// ─── HELPERS ────────────────────────────────────────────────────────────────
const fmt = n => (n||0).toLocaleString('vi-VN') + ' ₫';
const fmtM = n => n >= 1e6 ? (n/1e6).toFixed(1)+'tr₫' : (n||0).toLocaleString('vi-VN')+'₫';
const uid = () => Math.random().toString(36).slice(2,7).toUpperCase();
const today = () => new Date().toLocaleDateString('vi-VN');
const ini = name => name.split(' ').slice(-2).map(w=>w[0]).join('').toUpperCase().slice(0,2);
const av = (name, size=30, gold=false) =>
  `<div class="avatar" style="width:${size}px;height:${size}px;font-size:${size>36?13:10}px;background:${gold?'var(--gold)':'rgba(200,168,75,0.2)'};color:${gold?'#0c0c18':'var(--goldD)'};">${ini(name)}</div>`;
const badge = (label, bg, c, dot='') =>
  `<span class="badge" style="background:${bg};color:${c}">${dot?`<span class="badge-dot" style="background:${dot}"></span>`:''}${label}</span>`;
const statusBadge = s => { const m=STATUS_META[s]||STATUS_META.pending; return badge(m.label,m.bg,m.c,m.dot); };
const roleBadge = r => { const s=ROLE_STYLE[r]||{bg:'#f3f4f6',c:'#374151'}; return badge(r,s.bg,s.c); };
const tierBadge = spent => {
  if(spent>=2e6) return badge('⭐ Gold','#fef3c7','#92400e');
  if(spent>=1e6) return badge('Silver','#f1f5f9','#475569');
  return badge('Regular','#f3f4f6','#6b7280');
};
const stockClass = q => q<5?'stock-low':q<50?'stock-warn':'stock-ok';
const getTier = s => s>=2e6?'Gold':s>=1e6?'Silver':'Regular';

// ─── TOAST ──────────────────────────────────────────────────────────────────
function showToast(msg, type='success') {
  const icons = {success:'✓',danger:'✕',warning:'⚠'};
  const el = document.createElement('div');
  el.className = `toast ${type}`;
  el.innerHTML = `<span>${icons[type]||'✓'}</span> ${msg}`;
  document.getElementById('toast-container').appendChild(el);
  setTimeout(() => el.remove(), 2600);
}

// ─── MODAL ──────────────────────────────────────────────────────────────────
function openModal(title, html) {
  document.getElementById('modal-title').textContent = title;
  document.getElementById('modal-body').innerHTML = html;
  document.getElementById('modal-overlay').classList.add('open');
}
function closeModal(e) {
  if (e && e.target !== document.getElementById('modal-overlay')) return;
  document.getElementById('modal-overlay').classList.remove('open');
}
document.addEventListener('keydown', e => { if(e.key==='Escape') document.getElementById('modal-overlay').classList.remove('open'); });

// ─── NAVIGATION ─────────────────────────────────────────────────────────────
function gotoPage(id) {
  curPage = id;
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  const nb = document.getElementById('nav-'+id);
  if(nb) nb.classList.add('active');
  render();
}
function render() {
  const pages = {
    dashboard: renderDashboard,
    staff: renderStaff,
    customers: renderCustomers,
    orders: renderOrders,
    products: renderProducts,
    inventory: renderInventory,
    suppliers: renderSuppliers,
  };
  document.getElementById('main-content').innerHTML = (pages[curPage] || renderDashboard)();
}

// ─── DASHBOARD ──────────────────────────────────────────────────────────────
function renderDashboard() {
  const delivered = orders.filter(o=>o.status==='delivered');
  const revenue = delivered.reduce((s,o)=>s+o.total,0);
  const pending = orders.filter(o=>['pending','confirmed'].includes(o.status)).length;
  const lowStock = inventory.filter(i=>i.qty<=i.min).length;
  const monthly = [
    {m:'T1',r:1350000},{m:'T2',r:3010000},{m:'T3',r:1900000},{m:'T4',r:1195000},
    {m:'T5',r:2860000},{m:'T6',r:1190000},{m:'T7',r:2820000},{m:'T8',r:2670000},{m:'T9',r:2620000},
  ];
  const maxR = Math.max(...monthly.map(m=>m.r));
  const bars = monthly.map(m => {
    const h = Math.max(6, Math.round((m.r/maxR)*85));
    return `<div class="bar-col"><div class="bar-val">${(m.r/1e6).toFixed(1)}</div><div class="bar" style="height:${h}px"></div><div class="bar-lbl">${m.m}</div></div>`;
  }).join('');
  const statusBars = Object.entries(STATUS_META).map(([k,m]) => {
    const cnt = orders.filter(o=>o.status===k).length;
    const pct = orders.length ? Math.round(cnt/orders.length*100) : 0;
    return `<div class="status-row">
      <span style="font-size:11px;color:var(--txt);width:76px;flex-shrink:0">${m.label}</span>
      <div class="status-bar-bg"><div class="status-bar" style="width:${pct}%;background:${m.dot}"></div></div>
      <span style="font-size:11px;font-weight:700;color:var(--txt);width:20px;text-align:right">${cnt}</span>
    </div>`;
  }).join('');
  const recentRows = orders.slice(0,6).map(o => `<tr>
    <td><span class="order-id">${o.id}</span></td>
    <td>${o.cname.split(' ').slice(-2).join(' ')}</td>
    <td>${statusBadge(o.status)}</td>
    <td style="text-align:right;font-weight:700">${fmtM(o.total)}</td>
  </tr>`).join('');
  const vipList = [...customers].sort((a,b)=>b.spent-a.spent).slice(0,5).map(c => `
    <div style="padding:9px 0;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px">
      ${av(c.name)} <div style="flex:1;min-width:0">
        <div style="font-size:12px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${c.name}</div>
        <div style="font-size:11px;color:var(--muted)">${c.city}</div>
      </div>
      <div style="text-align:right">${fmtM(c.spent)}<br>${tierBadge(c.spent)}</div>
    </div>`).join('');
  const lowItems = inventory.filter(i=>i.qty<=i.min).slice(0,5).map(i=>`<tr>
    <td style="font-size:12px">${i.product}</td>
    <td><span class="monotype">${i.variant}</span></td>
    <td>${i.wh}</td>
    <td><span class="stock-low">${i.qty}</span></td>
  </tr>`).join('');
  return `
    <div class="page-header">
      <div><div class="page-title">Tổng quan</div><div class="page-sub">Hệ thống quản lý bán quần áo — FASHION Management</div></div>
    </div>
    <div class="kpi-grid">
      <div class="kpi"><div class="kpi-icon">💰</div><div class="kpi-label">Doanh thu (đã giao)</div><div class="kpi-val">${fmtM(revenue)}</div><div class="kpi-sub">${delivered.length} đơn hoàn thành</div></div>
      <div class="kpi"><div class="kpi-icon">🛍</div><div class="kpi-label">Tổng đơn hàng</div><div class="kpi-val">${orders.length}</div><div class="kpi-sub">${pending} đang chờ xử lý</div></div>
      <div class="kpi"><div class="kpi-icon">🧑‍🤝‍🧑</div><div class="kpi-label">Khách hàng</div><div class="kpi-val">${customers.length}</div><div class="kpi-sub">${customers.filter(c=>c.spent>=2e6).length} Gold, ${customers.filter(c=>c.spent>=1e6&&c.spent<2e6).length} Silver</div></div>
      <div class="kpi"><div class="kpi-icon">⚠️</div><div class="kpi-label">Cảnh báo kho</div><div class="kpi-val" style="color:#dc2626">${lowStock}</div><div class="kpi-sub">variant sắp hết hàng</div></div>
    </div>
    <div class="grid2">
      <div class="card"><div class="card-title">Doanh thu theo tháng (triệu đ)</div><div class="bar-wrap">${bars}</div></div>
      <div class="card"><div class="card-title">Trạng thái đơn hàng</div>${statusBars}</div>
    </div>
    <div class="grid2">
      <div class="tbl-wrap">
        <div class="tbl-head">Đơn hàng gần đây</div>
        <table><tbody>${recentRows}</tbody></table>
      </div>
      <div class="card" style="padding:14px 18px">
        <div class="card-title">Khách hàng VIP</div>${vipList}
      </div>
    </div>
    ${lowStock > 0 ? `<div class="tbl-wrap" style="margin-top:16px">
      <div class="tbl-head" style="color:#dc2626">⚠ Cảnh báo tồn kho thấp</div>
      <table><thead><tr><th>Sản phẩm</th><th>SKU</th><th>Kho</th><th>Tồn kho</th></tr></thead><tbody>${lowItems}</tbody></table>
    </div>` : ''}`;
}

// ─── STAFF ───────────────────────────────────────────────────────────────────
function renderStaff() {
  const roles = ['Tất cả',...ROLES];
  const shown = staff.filter(s => {
    const q = staffSearch.toLowerCase();
    return (!q || s.name.toLowerCase().includes(q) || s.email.includes(q))
        && (staffRoleF==='Tất cả' || s.role===staffRoleF);
  });
  const roleCounts = ROLES.map(r => {
    const cnt = staff.filter(s=>s.role===r).length;
    const st = ROLE_STYLE[r];
    return `<div class="kpi" style="padding:12px 14px">
      <div class="kpi-label" style="font-size:10px">${r}</div>
      <div class="kpi-val" style="font-size:20px">${cnt}</div>
      <div style="margin-top:6px">${badge(cnt===1?'người':'người',st.bg,st.c)}</div>
    </div>`;
  }).join('');
  const filterBtns = roles.map(r =>
    `<button class="filter-btn ${staffRoleF===r?'active':''}" onclick="setFilter('staffRoleF','${r}','renderStaff')">${r}</button>`
  ).join('');
  const rows = shown.length ? shown.map(s => `<tr>
    <td><div class="flex-center">${av(s.name)}<span style="font-weight:600">${s.name}</span></div></td>
    <td>${roleBadge(s.role)}</td>
    <td style="color:var(--muted)">${s.email}</td>
    <td style="color:var(--muted)">${s.phone}</td>
    <td><button class="toggle-status" style="background:${s.active?'var(--sL)':'var(--dL)'};color:${s.active?'var(--sD)':'var(--dD)'}" onclick="toggleStaff(${s.id})">${s.active?'● Hoạt động':'○ Tạm nghỉ'}</button></td>
    <td style="color:var(--muted)">${s.created}</td>
    <td><div class="flex-center"><button class="btn-sm" onclick="editStaff(${s.id})">Sửa</button><button class="btn-sm btn-danger" onclick="deleteStaff(${s.id})">Xóa</button></div></td>
  </tr>`).join('') : `<tr class="empty-row"><td colspan="7">Không có dữ liệu</td></tr>`;
  return `
    <div class="page-header">
      <div><div class="page-title">Nhân viên</div><div class="page-sub">${staff.length} nhân viên · ${staff.filter(s=>s.active).length} đang hoạt động</div></div>
      <button class="btn-primary" onclick="addStaff()">+ Thêm nhân viên</button>
    </div>
    <div class="grid5" style="margin-bottom:18px">${roleCounts}</div>
    <div class="toolbar">
      <div class="search-box"><span class="search-icon">⌕</span><input placeholder="Tìm nhân viên..." oninput="setSearch('staffSearch',this.value,'renderStaff')" value="${staffSearch}"></div>
      ${filterBtns}
    </div>
    <div class="tbl-wrap"><table>
      <thead><tr><th>Nhân viên</th><th>Vai trò</th><th>Email</th><th>Điện thoại</th><th>Trạng thái</th><th>Ngày tạo</th><th>Thao tác</th></tr></thead>
      <tbody>${rows}</tbody>
    </table></div>`;
}
window.toggleStaff = id => {
  staff = staff.map(s => s.id===id ? {...s,active:!s.active} : s);
  showToast('Cập nhật trạng thái thành công'); render();
};
window.deleteStaff = id => {
  if(!confirm('Xóa nhân viên này?')) return;
  staff = staff.filter(s=>s.id!==id); showToast('Đã xóa','danger'); render();
};
window.addStaff = () => openModal('Thêm nhân viên', staffForm({},'saveStaff'));
window.editStaff = id => { const s=staff.find(x=>x.id===id); openModal('Chỉnh sửa nhân viên', staffForm(s,'updateStaff',id)); };
function staffForm(s,fn,id='') {
  const roleOpts = ROLES.map(r=>`<option ${s.role===r?'selected':''}>${r}</option>`).join('');
  return `
    <div class="form-group"><label class="form-label">Họ và tên <span class="req">*</span></label><input class="form-input" id="sf-name" value="${s.name||''}"></div>
    <div class="form-group"><label class="form-label">Email <span class="req">*</span></label><input class="form-input" id="sf-email" type="email" value="${s.email||''}"></div>
    <div class="form-grid2">
      <div class="form-group"><label class="form-label">Điện thoại</label><input class="form-input" id="sf-phone" value="${s.phone||''}"></div>
      <div class="form-group"><label class="form-label">Vai trò</label><select class="form-select" id="sf-role">${roleOpts}</select></div>
    </div>
    <label style="display:flex;align-items:center;gap:8px;font-size:13px;margin-bottom:16px"><input type="checkbox" id="sf-active" ${s.active!==false?'checked':''}> Đang hoạt động</label>
    <div class="form-actions">
      <button class="btn-sm" onclick="closeModal()">Hủy</button>
      <button class="btn-primary" onclick="${fn}(${id})">${id?'Lưu thay đổi':'Thêm'}</button>
    </div>`;
}
window.saveStaff = () => {
  const name=document.getElementById('sf-name').value.trim();
  const email=document.getElementById('sf-email').value.trim();
  if(!name||!email){showToast('Điền đầy đủ thông tin','warning');return;}
  staff.push({id:Date.now(),name,email,phone:document.getElementById('sf-phone').value,role:document.getElementById('sf-role').value,active:document.getElementById('sf-active').checked,created:today()});
  showToast('Thêm nhân viên thành công'); closeModal(); render();
};
window.updateStaff = id => {
  const name=document.getElementById('sf-name').value.trim();
  if(!name){showToast('Tên không được trống','warning');return;}
  staff=staff.map(s=>s.id===id?{...s,name,email:document.getElementById('sf-email').value,phone:document.getElementById('sf-phone').value,role:document.getElementById('sf-role').value,active:document.getElementById('sf-active').checked}:s);
  showToast('Cập nhật thành công'); closeModal(); render();
