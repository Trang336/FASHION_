    <div class="form-grid2">
      <div class="form-group"><label class="form-label">Email</label><input class="form-input" id="supf-email" value="${s.email||''}"></div>
      <div class="form-group"><label class="form-label">Địa chỉ</label><input class="form-input" id="supf-addr" value="${s.address||''}"></div>
    </div>
    <label style="display:flex;align-items:center;gap:8px;font-size:13px;margin-bottom:16px"><input type="checkbox" id="supf-active" ${s.active!==false?'checked':''}> Đang hợp tác</label>
    <div class="form-actions"><button class="btn-sm" onclick="closeModal()">Hủy</button><button class="btn-primary" onclick="${fn}(${id})">${id?'Lưu':'Thêm'}</button></div>`;
}
window.saveSupplier = () => {
  const name=document.getElementById('supf-name').value.trim();
  if(!name){showToast('Tên không được trống','warning');return;}
  suppliers.push({id:Date.now(),name,contact:document.getElementById('supf-contact').value,phone:document.getElementById('supf-phone').value,email:document.getElementById('supf-email').value,address:document.getElementById('supf-addr').value,active:document.getElementById('supf-active').checked});
  showToast('Thêm nhà cung cấp thành công'); closeModal(); render();
};
window.updateSupplier = id => {
  suppliers=suppliers.map(s=>s.id===id?{...s,name:document.getElementById('supf-name').value,contact:document.getElementById('supf-contact').value,phone:document.getElementById('supf-phone').value,email:document.getElementById('supf-email').value,address:document.getElementById('supf-addr').value,active:document.getElementById('supf-active').checked}:s);
  showToast('Cập nhật thành công'); closeModal(); render();
};

// ─── GLOBAL HELPERS ──────────────────────────────────────────────────────────
window.setFilter = (key, val, fn) => {
  eval(`${key} = '${val}'`); eval(`${fn}()`);
  document.getElementById('main-content').innerHTML = eval(`${fn}()`);
};
window.setSearch = (key, val, fn) => {
  eval(`${key} = val`);
  document.getElementById('main-content').innerHTML = eval(`${fn}()`);
};

// ─── INIT ────────────────────────────────────────────────────────────────────
render();
</script>
</body>
</html>
