    <td style="color:var(--muted)">#${o.id}</td>
    <td>${o.customer}</td>
    <td style="color:var(--muted);font-size:12px">${o.staff}</td>
    <td style="color:var(--muted)">${o.date}</td>
    <td><span class="badge ${o.status}">${statusMap[o.status]}</span></td>
    <td style="color:var(--danger)">${o.discount > 0 ? '-'+o.discount.toLocaleString('vi-VN')+'₫' : '—'}</td>
    <td style="color:var(--accent2);font-weight:500">${o.total.toLocaleString('vi-VN')}₫</td>
  </tr>`).join('');
}

function filterOrder(btn, status) {
  document.querySelectorAll('#page-orders .filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const filtered = status === 'all' ? orders : orders.filter(o => o.status === status);
  renderOrders(filtered);
}

// ===== CUSTOMERS =====
function renderCustomers() {
  const tierMap = s => s >= 5000000 ? ['VIP Gold','gold'] : s >= 2000000 ? ['VIP Silver','silver'] : ['Regular','regular'];
  document.getElementById('customerBody').innerHTML = customers.map(c => {
    const [tier, cls] = tierMap(c.spent);
    return `<tr>
      <td style="color:var(--muted)">#${c.id}</td>
      <td style="font-weight:500">${c.name}</td>
      <td style="color:var(--muted);font-size:12px">${c.email}</td>
      <td>${c.gender}</td>
      <td style="color:var(--accent2)">${c.points} pts</td>
      <td style="color:var(--muted);font-size:12px">${c.address}</td>
      <td><span class="badge ${cls}">${tier}</span></td>
    </tr>`;
  }).join('');
}

// ===== INVENTORY =====
function renderInventory() {
  document.getElementById('inventoryBody').innerHTML = inventory.map(i => {
    const pct = Math.min(100, Math.round(i.qty / (i.min * 4) * 100));
    const cls = i.qty <= i.min ? 'low' : i.qty <= i.min * 3 ? 'mid' : '';
    const status = i.qty <= i.min ? `<span class="badge cancelled">⚠ Sắp hết</span>` : `<span class="badge delivered">✔ Còn hàng</span>`;
    return `<tr>
      <td style="font-family:monospace;font-size:11px;color:var(--accent2)">${i.sku}</td>
      <td>${i.name}</td><td>${i.size}</td><td>${i.color}</td><td>${i.wh}</td>
      <td><div style="font-weight:500;color:${i.qty<=i.min?'var(--danger)':'var(--text)'}">${i.qty}</div>
        <div class="inv-bar"><div class="inv-fill ${cls}" style="width:${pct}%"></div></div></td>
      <td style="color:var(--muted)">${i.min}</td>
      <td>${status}</td>
    </tr>`;
  }).join('');
}

