<!-- ======= PAGE: CUSTOMERS ======= -->
<div id="page-customers" class="main">
  <div class="page-title">Khách hàng (vw_TopCustomers)</div>
  <div class="page-sub">25 khách · Phân hạng VIP Gold / Silver / Regular · loyalty_points</div>
  <div class="stat-grid" style="grid-template-columns:repeat(3,1fr)">
    <div class="stat-card amber"><div class="stat-label">VIP Gold</div><div class="stat-value">2</div><div class="stat-sub">Chi tiêu ≥ 5,000,000₫</div></div>
    <div class="stat-card blue"><div class="stat-label">VIP Silver</div><div class="stat-value">4</div><div class="stat-sub">Chi tiêu ≥ 2,000,000₫</div></div>
