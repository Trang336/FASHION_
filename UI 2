      <div class="schema-col"><span>module</span><span class="col-type">NVARCHAR(50)</span></div>
      <div class="schema-col"><span>action</span><span class="col-type">NVARCHAR(50)</span></div>
      <div class="schema-col"><span>RolePermissions</span><span class="col-type">bridge table</span></div>
    </div>
    <div class="schema-table">
      <div class="schema-head">🚚 StockReceipts</div>
      <div class="schema-col"><span><span class="pk">PK</span> receipt_id</span><span class="col-type">INT IDENTITY</span></div>
      <div class="schema-col"><span><span class="fk">FK</span> supplier_id</span><span class="col-type">INT</span></div>
      <div class="schema-col"><span><span class="fk">FK</span> warehouse_id</span><span class="col-type">INT</span></div>
      <div class="schema-col"><span><span class="fk">FK</span> created_by</span><span class="col-type">INT</span></div>
      <div class="schema-col"><span>total_amount</span><span class="col-type">DECIMAL(14,2)</span></div>
      <div class="schema-col"><span>receipt_date</span><span class="col-type">DATETIME</span></div>
