      <div class="schema-col"><span>record_id</span><span class="col-type">INT</span></div>
      <div class="schema-col"><span>changed_by</span><span class="col-type">SYSTEM_USER</span></div>
      <div class="schema-col"><span>changed_at</span><span class="col-type">DATETIME</span></div>
