  <div id="tab-sql" style="display:none">
    <p style="font-size:12px;color:var(--muted);margin-bottom:12px">Ví dụ gọi stored procedure và query trực tiếp:</p>
    <div class="sql-block"><span class="sql-cm">-- Tạo đơn hàng qua sp_CreateOrder (XML items)</span><br>
<span class="sql-kw">DECLARE</span> @newId <span class="sql-kw">INT</span>;<br>
<span class="sql-kw">EXEC</span> <span class="sql-fn">sp_CreateOrder</span><br>
&nbsp;&nbsp;@customer_id = <span class="sql-str">1</span>,<br>
&nbsp;&nbsp;@created_by = <span class="sql-str">3</span>,<br>
&nbsp;&nbsp;@shipping_address = <span class="sql-str">N'Q1, TP.HCM'</span>,<br>
&nbsp;&nbsp;@discount_amount = <span class="sql-str">50000</span>,<br>
&nbsp;&nbsp;@items_xml = <span class="sql-str">'&lt;items&gt;&lt;i vid="1" qty="2"/&gt;&lt;i vid="9" qty="1"/&gt;&lt;/items&gt;'</span>,<br>
&nbsp;&nbsp;@warehouse_id = <span class="sql-str">2</span>,<br>
&nbsp;&nbsp;@new_order_id = @newId <span class="sql-kw">OUTPUT</span>;<br>
<span class="sql-kw">SELECT</span> @newId <span class="sql-kw">AS</span> NewOrderID;</div>

    <div class="sql-block"><span class="sql-cm">-- Xem báo cáo tháng qua View</span><br>
<span class="sql-kw">SELECT</span> yr, mo,<br>
&nbsp;&nbsp;total_orders, revenue,<br>
&nbsp;&nbsp;<span class="sql-fn">FORMAT</span>(avg_order_value, <span class="sql-str">'N0'</span>) <span class="sql-kw">AS</span> avg_value,<br>
&nbsp;&nbsp;unique_customers<br>
<span class="sql-kw">FROM</span> vw_MonthlyRevenue<br>
<span class="sql-kw">ORDER BY</span> yr, mo;</div>

    <div class="sql-block"><span class="sql-cm">-- Cảnh báo tồn kho sắp hết</span><br>
<span class="sql-kw">SELECT TOP</span> <span class="sql-str">10</span><br>
&nbsp;&nbsp;product_name, sku, size, color,<br>
&nbsp;&nbsp;warehouse_name, quantity, min_quantity,<br>
&nbsp;&nbsp;shortage<br>
<span class="sql-kw">FROM</span> vw_LowStockAlert<br>
<span class="sql-kw">ORDER BY</span> shortage <span class="sql-kw">DESC</span>;</div>

    <div class="sql-block"><span class="sql-cm">-- Phân quyền RBAC của user</span><br>
<span class="sql-kw">SELECT DISTINCT</span> full_name, role_name,<br>
&nbsp;&nbsp;<span class="sql-fn">STRING_AGG</span>(module + <span class="sql-str">':'</span> + action, <span class="sql-str">', '</span>) <span class="sql-kw">AS</span> permissions<br>
<span class="sql-kw">FROM</span> vw_UserPermissions<br>
<span class="sql-kw">GROUP BY</span> full_name, role_name<br>
<span class="sql-kw">ORDER BY</span> role_name;</div>
  </div>
