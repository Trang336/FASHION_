<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ClothingStoreDB — Demo Hệ Thống Quản Lý</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0f1117;--sidebar:#161b27;--card:#1c2333;--card2:#232b3e;
  --accent:#14b8a6;--accent2:#f59e0b;--text:#e2e8f0;--muted:#8892a4;
  --border:#2a3447;--success:#10b981;--warning:#f59e0b;--danger:#ef4444;
  --info:#3b82f6;
}
body{background:var(--bg);color:var(--text);font-family:'Segoe UI',system-ui,sans-serif;font-size:14px;display:flex;min-height:100vh}

/* SIDEBAR */
.sidebar{width:220px;background:var(--sidebar);border-right:1px solid var(--border);padding:0;display:flex;flex-direction:column;flex-shrink:0}
.logo{padding:20px 18px 16px;border-bottom:1px solid var(--border)}
.logo h1{font-size:17px;font-weight:700;color:var(--accent);letter-spacing:-.3px}
.logo p{font-size:11px;color:var(--muted);margin-top:2px}
.nav{padding:12px 0;flex:1}
.nav-item{display:flex;align-items:center;gap:10px;padding:9px 18px;cursor:pointer;color:var(--muted);font-size:13px;transition:all .15s;border-left:3px solid transparent}
.nav-item:hover{color:var(--text);background:rgba(255,255,255,.04)}
.nav-item.active{color:var(--accent);background:rgba(20,184,166,.08);border-left-color:var(--accent)}
.nav-item .icon{width:16px;text-align:center;font-size:15px}
.sidebar-footer{padding:14px 18px;border-top:1px solid var(--border);font-size:11px;color:var(--muted)}

/* MAIN */
.main{flex:1;overflow-y:auto;padding:24px;display:none}
.main.active{display:block}
.page-title{font-size:20px;font-weight:600;margin-bottom:4px}
.page-sub{font-size:12px;color:var(--muted);margin-bottom:20px}

/* CARDS */
.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px}
.stat-card{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:16px}
.stat-label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px}
.stat-value{font-size:24px;font-weight:700;line-height:1}
.stat-sub{font-size:11px;color:var(--muted);margin-top:4px}
.stat-card.green .stat-value{color:var(--success)}
.stat-card.teal .stat-value{color:var(--accent)}
.stat-card.amber .stat-value{color:var(--accent2)}
.stat-card.blue .stat-value{color:var(--info)}

/* CHART ROW */
.chart-row{display:grid;grid-template-columns:1.6fr 1fr;gap:14px;margin-bottom:20px}
.chart-card{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:16px}
.chart-title{font-size:13px;font-weight:600;margin-bottom:12px}
.chart-wrap{position:relative;height:200px}

/* TABLE */
.table-card{background:var(--card);border:1px solid var(--border);border-radius:10px;overflow:hidden;margin-bottom:20px}
.table-header{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid var(--border)}
.table-header h3{font-size:13px;font-weight:600}
.badge{display:inline-block;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:500}
.badge.delivered{background:rgba(16,185,129,.15);color:#34d399}
.badge.pending{background:rgba(245,158,11,.15);color:#fbbf24}
.badge.shipped{background:rgba(59,130,246,.15);color:#60a5fa}
.badge.confirmed{background:rgba(20,184,166,.15);color:#2dd4bf}
.badge.cancelled{background:rgba(239,68,68,.15);color:#f87171}
.badge.gold{background:rgba(245,158,11,.2);color:#f59e0b}
.badge.silver{background:rgba(148,163,184,.2);color:#94a3b8}
.badge.regular{background:rgba(100,116,139,.15);color:#64748b}
.badge.admin{background:rgba(168,85,247,.2);color:#c084fc}
.badge.manager{background:rgba(59,130,246,.2);color:#60a5fa}
.badge.sales{background:rgba(16,185,129,.2);color:#34d399}
.badge.warehouse{background:rgba(245,158,11,.2);color:#fbbf24}
.badge.viewer{background:rgba(100,116,139,.2);color:#94a3b8}

table{width:100%;border-collapse:collapse}
th{padding:9px 14px;text-align:left;font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;border-bottom:1px solid var(--border);background:var(--card2)}
td{padding:9px 14px;border-bottom:1px solid rgba(42,52,71,.5);font-size:13px;vertical-align:middle}
tr:last-child td{border-bottom:none}
tr:hover td{background:rgba(255,255,255,.02)}

/* TABS */
.tabs{display:flex;gap:0;border-bottom:1px solid var(--border);margin-bottom:16px}
.tab-btn{padding:8px 14px;font-size:12px;cursor:pointer;color:var(--muted);border:none;background:none;border-bottom:2px solid transparent;margin-bottom:-1px;transition:all .15s}
.tab-btn.active{color:var(--accent);border-bottom-color:var(--accent)}

/* PROCEDURE / FUNCTION CARDS */
.feature-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-bottom:16px}
.feature-card{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:14px}
.feature-card h4{font-size:12px;font-weight:600;color:var(--accent);margin-bottom:4px;font-family:monospace}
.feature-card p{font-size:12px;color:var(--muted);line-height:1.5}

/* SCHEMA */
.schema-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.schema-table{background:var(--card);border:1px solid var(--border);border-radius:8px;overflow:hidden}
.schema-head{background:var(--card2);padding:8px 12px;font-size:12px;font-weight:600;color:var(--accent);border-bottom:1px solid var(--border)}
.schema-col{padding:5px 12px;font-size:11px;color:var(--muted);border-bottom:1px solid rgba(42,52,71,.4);display:flex;justify-content:space-between}
.schema-col:last-child{border-bottom:none}
.col-type{color:var(--accent2);font-family:monospace;font-size:10px}
.pk{color:#c084fc;font-size:9px;background:rgba(168,85,247,.15);padding:1px 4px;border-radius:3px}
.fk{color:#60a5fa;font-size:9px;background:rgba(59,130,246,.15);padding:1px 4px;border-radius:3px}

/* INVENTORY bars */
.inv-bar{height:6px;border-radius:3px;background:var(--border);overflow:hidden;margin-top:4px}
.inv-fill{height:100%;border-radius:3px;background:var(--accent);transition:width .3s}
.inv-fill.low{background:var(--danger)}
.inv-fill.mid{background:var(--warning)}

/* Search */
.search-box{padding:6px 12px;border:1px solid var(--border);border-radius:6px;background:var(--card2);color:var(--text);font-size:12px;width:200px;outline:none}
.search-box:focus{border-color:var(--accent)}

/* Filter badge */
.filter-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:12px}
.filter-btn{padding:4px 10px;border-radius:20px;font-size:11px;cursor:pointer;border:1px solid var(--border);background:var(--card2);color:var(--muted);transition:all .15s}
.filter-btn.active{background:rgba(20,184,166,.15);border-color:var(--accent);color:var(--accent)}

/* SQL block */
.sql-block{background:#0d1117;border:1px solid var(--border);border-radius:8px;padding:12px 14px;font-family:monospace;font-size:12px;color:#c9d1d9;overflow-x:auto;margin-bottom:10px;line-height:1.6}
.sql-kw{color:#ff7b72}
.sql-fn{color:#d2a8ff}
.sql-str{color:#a5d6ff}
.sql-cm{color:#8b949e}
</style>
</head>
<body>

<!-- SIDEBAR -->
<div class="sidebar">
  <div class="logo">
    <h1>🧥 ClothingStoreDB</h1>
    <p>Đồ án CSDL Nâng Cao</p>
  </div>
  <nav class="nav">
    <div class="nav-item active" onclick="showPage('dashboard')"><span class="icon">📊</span> Tổng quan</div>
    <div class="nav-item" onclick="showPage('schema')"><span class="icon">🗂</span> Schema</div>
    <div class="nav-item" onclick="showPage('products')"><span class="icon">👕</span> Sản phẩm</div>
    <div class="nav-item" onclick="showPage('orders')"><span class="icon">🛒</span> Đơn hàng</div>
    <div class="nav-item" onclick="showPage('customers')"><span class="icon">👥</span> Khách hàng</div>
    <div class="nav-item" onclick="showPage('inventory')"><span class="icon">📦</span> Tồn kho</div>
    <div class="nav-item" onclick="showPage('reports')"><span class="icon">📈</span> Báo cáo</div>
    <div class="nav-item" onclick="showPage('rbac')"><span class="icon">🔐</span> Phân quyền</div>
    <div class="nav-item" onclick="showPage('features')"><span class="icon">⚙️</span> Views / Procs</div>
    <div class="nav-item" onclick="showPage('security')"><span class="icon">🛡</span> Bảo mật DB</div>
  </nav>
  <div class="sidebar-footer">SQL Server 2022 · ClothingStoreDB<br>FINAL v2 · 17 tables</div>
</div>

