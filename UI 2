<!-- ======= PAGE: SCHEMA ======= -->
<div id="page-schema" class="main">
  <div class="page-title">Cấu trúc Database</div>
  <div class="page-sub">ClothingStoreDB · 17 bảng · SQL Server 2022 · Collate Vietnamese_CI_AS</div>
  <div class="schema-grid">
    <div class="schema-table">
      <div class="schema-head">📋 Orders</div>
      <div class="schema-col"><span><span class="pk">PK</span> order_id</span><span class="col-type">INT IDENTITY</span></div>
      <div class="schema-col"><span><span class="fk">FK</span> customer_id</span><span class="col-type">INT</span></div>
      <div class="schema-col"><span><span class="fk">FK</span> created_by</span><span class="col-type">INT</span></div>
      <div class="schema-col"><span>status</span><span class="col-type">NVARCHAR(30)</span></div>
      <div class="schema-col"><span>total_amount</span><span class="col-type">DECIMAL(14,2)</span></div>
      <div class="schema-col"><span>is_stock_reserved</span><span class="col-type">BIT</span></div>
    </div>
    <div class="schema-table">
      <div class="schema-head">👕 Products</div>
      <div class="schema-col"><span><span class="pk">PK</span> product_id</span><span class="col-type">INT IDENTITY</span></div>
      <div class="schema-col"><span><span class="fk">FK</span> category_id</span><span class="col-type">INT</span></div>
      <div class="schema-col"><span><span class="fk">FK</span> brand_id</span><span class="col-type">INT</span></div>
      <div class="schema-col"><span>product_name</span><span class="col-type">NVARCHAR(200)</span></div>
      <div class="schema-col"><span>base_price</span><span class="col-type">DECIMAL(12,2)</span></div>
      <div class="schema-col"><span>is_active</span><span class="col-type">BIT DEFAULT 1</span></div>
    </div>
    <div class="schema-table">
      <div class="schema-head">🔀 ProductVariants</div>
      <div class="schema-col"><span><span class="pk">PK</span> variant_id</span><span class="col-type">INT IDENTITY</span></div>
      <div class="schema-col"><span><span class="fk">FK</span> product_id</span><span class="col-type">INT</span></div>
      <div class="schema-col"><span>size</span><span class="col-type">NVARCHAR(10)</span></div>
      <div class="schema-col"><span>color</span><span class="col-type">NVARCHAR(50)</span></div>
      <div class="schema-col"><span>sku</span><span class="col-type">VARCHAR(60) UNIQUE</span></div>
      <div class="schema-col"><span>extra_price</span><span class="col-type">DECIMAL(12,2)</span></div>
    </div>
    <div class="schema-table">
      <div class="schema-head">📦 Inventory</div>
      <div class="schema-col"><span><span class="pk">PK</span> inventory_id</span><span class="col-type">INT IDENTITY</span></div>
      <div class="schema-col"><span><span class="fk">FK</span> variant_id</span><span class="col-type">INT</span></div>
      <div class="schema-col"><span><span class="fk">FK</span> warehouse_id</span><span class="col-type">INT</span></div>
      <div class="schema-col"><span>quantity</span><span class="col-type">INT ≥ 0</span></div>
      <div class="schema-col"><span>min_quantity</span><span class="col-type">INT DEFAULT 5</span></div>
      <div class="schema-col"><span>updated_at</span><span class="col-type">DATETIME</span></div>
    </div>
    <div class="schema-table">
      <div class="schema-head">👤 Customers</div>
      <div class="schema-col"><span><span class="pk">PK</span> customer_id</span><span class="col-type">INT IDENTITY</span></div>
      <div class="schema-col"><span>full_name</span><span class="col-type">NVARCHAR(100)</span></div>
      <div class="schema-col"><span>email</span><span class="col-type">NVARCHAR(100)</span></div>
      <div class="schema-col"><span>gender</span><span class="col-type">CHK: Nam/Nữ/Khác</span></div>
      <div class="schema-col"><span>loyalty_points</span><span class="col-type">INT DEFAULT 0</span></div>
      <div class="schema-col"><span>birthday</span><span class="col-type">DATE</span></div>
    </div>
    <div class="schema-table">
      <div class="schema-head">💳 Payments</div>
      <div class="schema-col"><span><span class="pk">PK</span> payment_id</span><span class="col-type">INT IDENTITY</span></div>
      <div class="schema-col"><span><span class="fk">FK</span> order_id</span><span class="col-type">INT</span></div>
      <div class="schema-col"><span>amount</span><span class="col-type">DECIMAL(14,2)</span></div>
      <div class="schema-col"><span>method</span><span class="col-type">NVARCHAR(50)</span></div>
      <div class="schema-col"><span>status</span><span class="col-type">pending/completed…</span></div>
      <div class="schema-col"><span>transaction_ref</span><span class="col-type">VARCHAR(100)</span></div>
    </div>
    <div class="schema-table">
      <div class="schema-head">🔑 Roles + Permissions</div>
      <div class="schema-col"><span>role_id / role_name</span><span class="col-type">UNIQUE</span></div>
